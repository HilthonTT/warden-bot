# Bot token from https://discord.com/developers/applications
DISCORD_TOKEN=your_token_here

# Optional: a guild ID for instant slash-command sync during development.
# Leave empty for a global sync (can take up to ~1 hour to propagate).
DEV_GUILD_ID=

# Optional: bot presence string shown under its name.
ACTIVITY_STATUS=Always monitoring your behavior

# Optional: where the SQLite database lives.
# Defaults to data/bot.sqlite3, relative to the working directory.
BOT_DB_PATH=

# Optional: CRITICAL, ERROR, WARNING, INFO or DEBUG. Defaults to INFO.
LOG_LEVEL=
